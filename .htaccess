<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On

    # 1. API Endpoint Routing -> PHP Router
    RewriteRule ^api/(.*)$ backend/public/index.php [QSA,L]
    RewriteRule ^api$ backend/public/index.php [QSA,L]

    # 2. Allow Direct File Downloads
    RewriteRule ^downloads/(.*)$ downloads/$1 [L]

    # 3. Serve existing static files & directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. React Single Page Application (SPA) fallback to index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Caching Policy: Force bypass on cPanel NGINX Reverse Proxy, LiteSpeed, and Browser
<IfModule mod_headers.c>
    # 1. Never cache HTML so React UI updates are seen immediately
    <FilesMatch "\.(html|htm)$">
        Header always set Cache-Control "max-age=0, no-cache, no-store, must-revalidate, proxy-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
        Header always set X-Accel-Expires "0"
        Header always set X-LiteSpeed-Cache-Control "no-cache"
    </FilesMatch>

    # 2. Disable proxy & browser caching for API responses
    <FilesMatch "(index\.php)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always set X-Accel-Expires "0"
        Header always set X-LiteSpeed-Cache-Control "no-cache"
    </FilesMatch>

    # 3. Allow long-term caching for hashed assets only
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Security: Block sensitive file extensions
<FilesMatch "\.(env|sql|bat|log|md|git.*|yml|yaml|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow public access to manifest / custom assets if needed
<FilesMatch "^(custom_db\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Enable GZIP compression for faster loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>
